<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/content_padding_below_fab_menu"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/icon_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/select_icon"
                android:contentDescription="@string/choose_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:icon="@drawable/ic_actionbar_select_icon"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

            <Button
                android:id="@+id/delete_icon"
                android:contentDescription="@string/remove_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:icon="@drawable/ic_actionbar_delete"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

            <Button
                android:id="@+id/copy_icon_to_server"
                android:contentDescription="@string/copy_to_the_server"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:icon="@drawable/ic_actionbar_clone"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

            <Button
                android:id="@+id/copy_icon_to_clipboard"
                android:contentDescription="@string/copy_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:icon="@drawable/ic_actionbar_copy"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

            <Button
                android:id="@+id/paste_icon_from_clipboard"
                android:contentDescription="@string/paste_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:icon="@drawable/ic_actionbar_paste"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/server_identity_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:text="@string/server_identity"
                style="@style/FormLabel" />

            <Spinner
                android:id="@+id/server_identity_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/service"
                style="?attr/textInputOutlinedStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/account"
                style="?attr/textInputOutlinedStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri|textNoSuggestions|textVisiblePassword"
                    android:lines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groups_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:text="@string/group"
                style="@style/FormLabel" />

            <Spinner
                android:id="@+id/group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/current_otp"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <Button
                android:id="@+id/toggle_otp_generation_attributes_visualization"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/otp_generation_attributes_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:text="@string/otp_type"
                    style="@style/FormLabel" />

                <LinearLayout
                    android:id="@+id/otp_types_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/otp_type"
                        style="@style/SegmentButton"
                        android:text="@string/otp_type_totp"
                        android:tag="totp" />

                    <Button
                        android:id="@id/otp_type"
                        style="@style/SegmentButton"
                        android:text="@string/otp_type_hotp"
                        android:tag="hotp" />

                    <Button
                        android:id="@id/otp_type"
                        style="@style/SegmentButton"
                        android:text="@string/otp_type_steam"
                        android:tag="steamtotp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/secret"
                        style="?attr/textInputOutlinedStyle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/secret"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri|textNoSuggestions|textVisiblePassword"
                            android:importantForAutofill="no"
                            android:lines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/copy_secret"
                        android:contentDescription="@string/copy_secret"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:icon="@drawable/ic_actionbar_copy"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/digits_block_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:text="@string/digits"
                    style="@style/FormLabel" />

                <LinearLayout
                    android:id="@+id/digits_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/digit"
                        style="@style/SegmentButton"
                        android:text="@string/number_6"
                        android:tag="6" />

                    <Button
                        android:id="@id/digit"
                        style="@style/SegmentButton"
                        android:text="@string/number_7"
                        android:tag="7" />

                    <Button
                        android:id="@id/digit"
                        style="@style/SegmentButton"
                        android:text="@string/number_8"
                        android:tag="8" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/algorithms_block_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:text="@string/algorithm"
                    style="@style/FormLabel" />

                <LinearLayout
                    android:id="@+id/algorithms_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/algorithm"
                        style="@style/SegmentButton"
                        android:text="@string/algorithm_sha1"
                        android:tag="sha1" />

                    <Button
                        android:id="@id/algorithm"
                        style="@style/SegmentButton"
                        android:text="@string/algorithm_sha256"
                        android:tag="sha256" />

                    <Button
                        android:id="@id/algorithm"
                        style="@style/SegmentButton"
                        android:text="@string/algorithm_sha512"
                        android:tag="sha512" />

                    <Button
                        android:id="@id/algorithm"
                        style="@style/SegmentButton"
                        android:text="@string/algorithm_md5"
                        android:tag="md5" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/period_block_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/period"
                    style="?attr/textInputOutlinedStyle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:digits="0123456789"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/counter_block_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/counter"
                    style="?attr/textInputOutlinedStyle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/counter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:digits="0123456789"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>


